# Kopiér til .env.local og udfyld fra Supabase: Project Settings → API Keys (anon eller publishable).
# Begge værdier er offentlige og må gerne ligge i appen. Rækkesikkerheden i
# databasen beskytter data. Hemmelige nøgler hører aldrig hjemme her.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Valgfri. Fejlrapportering til Sentry (EU). Uden adresse sendes ingenting.
EXPO_PUBLIC_SENTRY_DSN=
